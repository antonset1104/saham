# ==========================================
# KONFIGURASI KUNCI API & KREDENSIAL
# Salin file ini menjadi '.env' dan isi nilainya
# ==========================================

# Token Akun Stockbit (Bearer Token) untuk data Broker Summary
STOCKBIT_TOKEN=

# Kunci API Google AI Studio / Gemini
GEMINI_API_KEY=

# Kunci API Groq (Llama 3.1 / 3.3 / DeepSeek)
GROQ_API_KEY=

# Kunci API OpenRouter
OPENROUTER_API_KEY=

# Konfigurasi Notifikasi Telegram Bot (Opsional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Token Cloudflare Tunnel (Opsional, kosongkan jika menggunakan Quick Tunnel gratis)
CLOUDFLARE_TUNNEL_TOKEN=
